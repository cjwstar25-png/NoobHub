local function performReloadWithLoading()
    resetLoadedFlag()
    _G.__cubicLoadingDone = nil
    _G.__cubicForceLoad = true
    _G.__cubicWarnInstalled = nil
    hooksInstalled = false

    if NC_ORIG then
        pcall(function()
            local mt = getrawmetatable(game)
            if HAS_SETRO then setreadonly(mt, false) end
            mt.__namecall = NC_ORIG
            if HAS_SETRO then setreadonly(mt, true) end
        end)
    end

    local src = _G.__cubicSource or _SELF_SOURCE
    local loader = nil
    pcall(function()
        if type(loadstring) == "function" then loader = loadstring
        elseif type(load) == "function" then loader = load end
    end)

    if not (src and type(src) == "string" and #src > 0 and loader) then
        pcall(function() Lighting.Brightness = 1; Lighting.ClockTime = 14; Lighting.GlobalShadows = true end)
        pcall(function() Workspace.Gravity = 196.2 end)
        pcall(function()
            local char = LocalPlayer.Character
            if char then char:BreakJoints() end
        end)
        if _G.__cubicShowToast then _G.__cubicShowToast("Reload unavailable. Re-execute manually.", nil, P.danger) end
        return
    end

    pcall(function() ScreenGui:Destroy() end)
    pcall(function() OverlayGui:Destroy() end)
    local oldLoading = CoreGui:FindFirstChild("CubicLoading")
    if oldLoading then pcall(function() oldLoading:Destroy() end) end

    task.wait(0.4)

    local f, lerr = loader(src)
    if not f then
        pcall(function() warn("[Cubic] load: " .. tostring(lerr)) end)
        if _G.__cubicShowToast then _G.__cubicShowToast("Reload failed. Re-execute manually.", nil, P.danger) end
        return
    end
    local ok, rerr = pcall(f)
    if not ok then pcall(function() warn("[Cubic] run: " .. tostring(rerr)) end) end
end


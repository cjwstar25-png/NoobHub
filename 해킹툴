                    local msg = scanRenderResult(p, entry)
                    if showToast then showToast("FLAG: " .. msg, true, P.warn) end
                    if states.ScanLogToChat and sendChatMessage then pcall(function() sendChatMessage("[scan] " .. msg) end) end
                    scanFlagged[p] = {score = entry.score, reasons = entry.reasons, lastSeen = tick()}
                end
            end
            if flagged == 0 then if showToast then showToast("Scan: no flags", nil) end
            else if showToast then showToast("Scan: " .. flagged .. " flagged", true, P.warn) end end
        end
        _G.__cubicClearScan = function()
            scanFlagged = {}
            for _, entry in pairs(scanHistory) do
                entry.score = 0; entry.reasons = {}; entry.velSamples = {}
            end
        end

        local scanTimer, scanReportTimer = 0, 0
        RunService.Heartbeat:Connect(function(dt)
            if not initComplete then return end
            if not states.CheatScan then return end
            scanTimer = scanTimer + dt
            if scanTimer >= 0.15 then
                scanTimer = 0
                for _, p in ipairs(Players:GetPlayers()) do pcall(scanUpdatePlayer, p) end
            end
            scanReportTimer = scanReportTimer + dt
            if scanReportTimer >= 8 then
                scanReportTimer = 0
                for p, entry in pairs(scanHistory) do
                    if p.Parent and entry.score >= 20 and entry.reasons[1] then
                        local flag = scanFlagged[p]
                        if not flag or flag.reasons[1] ~= entry.reasons[1] then
                            local msg = scanRenderResult(p, entry)
                            if showToast then showToast("SCAN: " .. msg, true, P.warn) end
                            if states.ScanLogToChat and sendChatMessage then pcall(function() sendChatMessage("[scan] " .. msg) end) end
                            scanFlagged[p] = {score = entry.score, reasons = entry.reasons, lastSeen = tick()}
                        end
                    end
                end
            end
        end)
    end


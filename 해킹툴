local isValidTarget, getClosestTarget, killAuraHit
local fireGenericRemotes, fireCapturedAttack
local lastHitTime = setmetatable({}, {__mode = "k"})
local KILL_WINDOW = 5

registerHit = function(player)
    if player and typeof(player) == "Instance" and player:IsA("Player") then
        lastHitTime[player] = tick()
    end
end

do
    local function _isValid(player)
        if player == LocalPlayer then return false end
        local char = player.Character
        if not char then return false end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        if states.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
        return true
    end
    isValidTarget = _isValid

    getClosestTarget = function()
        local char = LocalPlayer.Character
        if not char then return nil, math.huge end
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil, math.huge end
        local myPos = myRoot.Position
        local best, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if _isValid(p) then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local d = (myPos - head.Position).Magnitude
                    if d < bestDist then bestDist = d; best = p end
                end
            end
        end
        return best, bestDist
    end
    getClosestTargetRef = getClosestTarget

    local function mapArgToTarget(origArg, target, targetChar, eHum, eRoot)
        local t = typeof(origArg)
        if t == "Instance" then
            if origArg:IsA("Player") then return target end
            if origArg:IsA("Humanoid") then return eHum end
            if origArg:IsA("BasePart") then
                local name = origArg.Name
                local match = targetChar:FindFirstChild(name)
                if match and match:IsA("BasePart") then return match end
                return eRoot
            end
            if origArg:IsA("Model") then return targetChar end
            return targetChar
        elseif t == "Vector3" then return eRoot.Position
        elseif t == "CFrame" then return eRoot.CFrame
        else return origArg end
    end

    fireCapturedAttack = function(target, targetChar, eHum, eRoot)
        if not capturedAttack or not capturedAttack.remote then return false end
        if not canFire() then return false end
        local newArgs = {}
        for i, _t in ipairs(capturedAttack.argTypes) do
            newArgs[i] = mapArgToTarget(capturedAttack.args[i], target, targetChar, eHum, eRoot)
        end
        local ok = pcall(function() capturedAttack.remote:FireServer(table.unpack(newArgs)) end)
        markFired()
        return ok
    end

    local AttackRemote, DamageRemote, HitRemote

    fireGenericRemotes = function(target, targetChar, eHum, eRoot)
        if not canFire() then return end
        local candidates = {}
        if AttackRemote then table.insert(candidates, AttackRemote) end
        if DamageRemote then table.insert(candidates, DamageRemote) end
        if HitRemote then table.insert(candidates, HitRemote) end
        if #candidates == 0 then return end
        local pick = candidates[math.random(1, #candidates)]
        local argChoice = math.random(1, 3)
        pcall(function()
            if argChoice == 1 then pick:FireServer(targetChar)
            elseif argChoice == 2 then pick:FireServer(eRoot)
            else pick:FireServer(target) end
        end)
        markFired()
    end

    local lastToolActivate = 0
    local function tryToolActivate()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and tick() - lastToolActivate > 0.1 then
            lastToolActivate = tick()
            pcall(function() tool:Activate() end)
        end
    end

    killAuraHit = function(target, targetChar)
        if not targetChar or not targetChar.Parent then return end
        local eRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local eHum  = targetChar:FindFirstChild("Humanoid")
        if not eRoot or not eHum or eHum.Health <= 0 then return end
        local usedCapture = false
        if capturedAttack and capturedAttack.remote and states.KillAuraUseCapture then
            usedCapture = fireCapturedAttack(target, targetChar, eHum, eRoot)
        end
        if not usedCapture then fireGenericRemotes(target, targetChar, eHum, eRoot) end
        tryToolActivate()
        if states.KillAuraLocalDamage then
            local dmg = settingsConfig.KillAuraLocalDamageAmount or 15
            pcall(function() eHum:TakeDamage(dmg) end)
        end
    end

    _G.__cubicKillAuraHit = killAuraHit

    -- Remote discovery
    local discoveredRemotes = {}
    local scoreName = function(n, words)
        local s = 0
        for _, w in ipairs(words) do if n:find(w) then s = s + 10 end end
        return s
    end
    local isBlacklisted = function(n)
        for _, w in ipairs(_BL_WORDS) do if n:find(w) then return true end end
        return false
    end
    local function collectRemotes()
        discoveredRemotes = {}
        local roots = {
            ReplicatedStorage, LocalPlayer,
            LocalPlayer:FindFirstChild("PlayerScripts"),
            LocalPlayer:FindFirstChild("PlayerGui"),
            LocalPlayer:FindFirstChild("Backpack"),
            LocalPlayer:FindFirstChild("Character"),
        }
        for _, root in ipairs(roots) do
            if root then
                pcall(function()
                    for _, v in ipairs(root:GetDescendants()) do
                        if v:IsA("RemoteEvent") then table.insert(discoveredRemotes, v) end
                    end
                end)
                task.wait(0.03)
            end
        end
    end

    _G.__cubicAnalyzeRemotes = function()
        collectRemotes()
        local bestAtk, bestAtkScore = nil, 0
        local bestDmg, bestDmgScore = nil, 0
        local bestHit, bestHitScore = nil, 0
        for _, ev in ipairs(discoveredRemotes) do
            local n = ev.Name:lower()
            local fn = ev:GetFullName():lower()
            if not isBlacklisted(n) and not isBlacklisted(fn) then
                local atk = scoreName(n, _ATK_WORDS)
                local dmg = scoreName(n, _DMG_WORDS)
                if atk > bestAtkScore then bestAtkScore = atk; bestAtk = ev end
                if dmg > bestDmgScore and ev ~= bestAtk then bestDmgScore = dmg; bestDmg = ev end
                if (atk + dmg) > bestHitScore and ev ~= bestAtk and ev ~= bestDmg then
                    bestHitScore = atk + dmg; bestHit = ev
                end
            end
        end
        if bestAtkScore >= 10 then AttackRemote = bestAtk end
        if bestDmgScore >= 10 then DamageRemote = bestDmg end
        if bestHitScore >= 10 then HitRemote = bestHit end
        _G.__cubicAttackRemote = AttackRemote
        _G.__cubicDamageRemote = DamageRemote
        _G.__cubicHitRemote = HitRemote
    end
end

-- Chat + misc
local sendChatMessage
do
    local function pickChatSpamMessage()
        local raw = settingsConfig.ChatSpamMessage or "gg"
        local pool = {}
        for msg in string.gmatch(raw, "[^,\n]+") do
            local t = msg:match("^%s*(.-)%s*$")
            if t and #t > 0 then table.insert(pool, t) end
        end
        if #pool == 0 then return nil end
        return pool[math.random(1, #pool)]
    end
    _G.__cubicPickChatSpamMessage = pickChatSpamMessage

    sendChatMessage = function(msg)
        if not msg or msg == "" then return end
        pcall(function()
            local TCS = game:GetService("TextChatService")
            if TCS and TCS.ChatVersion == Enum.ChatVersion.TextChatService then
                local ch = TCS:FindFirstChild("TextChannels")
                if ch then
                    local gen = ch:FindFirstChild("RBXGeneral")
                    if gen then gen:SendAsync(msg) end
                end
            end
        end)
        pcall(function()
            local ev = ReplicatedStorage:FindFirstChild("DefaultDefaultChatSystemChatEvents")
            if not ev then ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") end
            if ev then
                local s = ev:FindFirstChild("SayMessageRequest")
                if s then s:FireServer(msg, "All") end
            end
        end)
    end

    local lastSpamTime = 0
    _G.__cubicTrySendSpam = function(msg)
        local delay = settingsConfig.ChatSpamDelay or 1.5
        if tick() - lastSpamTime < delay then return false end
        lastSpamTime = tick()
        sendChatMessage(msg)
        return true
    end
end

local function smoothLookAt(targetPos, smoothness, dt)
    local cam = getCamera()
    if not cam then return end
    local goal = CFrame.new(cam.CFrame.Position, targetPos)
    local alpha = math.clamp(smoothness * dt * 60, 0, 1)
    cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end


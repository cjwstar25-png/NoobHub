local function buildHexLogo(parent, size, color)
    local holder = Instance.new("Frame", parent)
    holder.Size = UDim2.new(0, size, 0, size)
    holder.BackgroundTransparency = 1
    local r = size * 0.40
    local cx, cy = size/2, size/2
    local thick = math.max(1.5, size * 0.10)
    local function bar(x1, y1, x2, y2)
        local dx, dy = x2-x1, y2-y1
        local len = math.sqrt(dx*dx + dy*dy)
        local ang = math.deg(math.atan2(dy, dx))
        local f = Instance.new("Frame", holder)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Size = UDim2.new(0, len, 0, thick)
        f.Position = UDim2.new(0, (x1+x2)/2, 0, (y1+y2)/2)
        f.Rotation = ang
        f.BackgroundColor3 = color
        f.BorderSizePixel = 0
    end
    local verts = {}
    for i = 0, 5 do
        local a = math.rad(i * 60 - 30)
        verts[i+1] = { cx + r * math.cos(a), cy + r * math.sin(a) }
    end
    for i = 1, 6 do
        local v1 = verts[i]
        local v2 = verts[(i % 6) + 1]
        bar(v1[1], v1[2], v2[1], v2[2])
    end
    bar(cx, cy, verts[2][1], verts[2][2])
    bar(cx, cy, verts[4][1], verts[4][2])
    bar(cx, cy, verts[6][1], verts[6][2])
end


local function isCaptureBlacklisted(n)
    for _, w in ipairs(_CAP_BL) do if n:find(w) then return true end end
    return false
end

local NC_ORIG = nil
local warnRecursionGuard = false
local hooksInstalled = false
local capturedAttack = nil
local captureArmed = false
local capturedRemotes = {}
local lastFireTime = 0

local function getFireDelay()
    if settingsConfig.StealthMode then return 0.15 end
    return settingsConfig.FireDelay or 0.05
end

local function canFire() return tick() - lastFireTime >= getFireDelay() end
local function markFired() lastFireTime = tick() end

local function installNamecallHook()
    if hooksInstalled then return end
    if settingsConfig.StealthMode then return end
    if not (HAS_HOOKMM and HAS_RAWMT and HAS_GETNC) then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if HAS_SETRO then setreadonly(mt, false) end
        if NC_ORIG == nil then NC_ORIG = mt.__namecall end
        mt.__namecall = nc(function(self, ...)
            local m = getnamecallmethod()
            if _BLOCKED[m] then return nil end
            if m == "FireServer" and self and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                local n = self.Name:lower()
                for _, w in ipairs(_SUS) do
                    if n:find(w) then capturedRemotes[self] = true; return nil end
                end
                if captureArmed and not isCaptureBlacklisted(n) then
                    local args = {...}; local argTypes = {}
                    for i, v in ipairs(args) do argTypes[i] = typeof(v) end
                    capturedAttack = { remote = self, remoteName = self:GetFullName(), args = args, argTypes = argTypes, capturedAt = tick() }
                    captureArmed = false
                    if _G.__cubicOnCapture then _G.__cubicOnCapture(capturedAttack) end
                end
            end
            if m == "FireServer" and states.SilentAim and getClosestTargetRef then
                local char = LocalPlayer.Character
                if char then
                    local target, dist = getClosestTargetRef()
                    if target and dist < (settingsConfig.KillAuraRange or 100) then
                        local head = target.Character and target.Character:FindFirstChild("Head")
                        if head then
                            local args = {...}; local replaced = false
                            for i, v in ipairs(args) do
                                if typeof(v) == "Vector3" then args[i] = head.Position; replaced = true end
                            end
                            if replaced then
                                if registerHit then registerHit(target) end
                                return NC_ORIG(self, table.unpack(args))
                            end
                        end
                    end
                end
            end
            return NC_ORIG(self, ...)
        end)
        if HAS_SETRO then setreadonly(mt, true) end
        hooksInstalled = true
    end)
end

local function installSafeWarnHook()
    if settingsConfig.StealthMode then return end
    if not HAS_HOOKFN then return end
    if _G.__cubicWarnInstalled then return end
    _G.__cubicWarnInstalled = true
    pcall(function()
        if type(warn) ~= "function" then return end
        local oldWarn = warn
        hookfunction(warn, nc(function(...)
            if warnRecursionGuard then return oldWarn(...) end
            warnRecursionGuard = true
            local args = {...}; local keep = {}; local drop = false
            for i, a in ipairs(args) do
                if type(a) == "string" then
                    local l = a:lower()
                    for _, kw in ipairs(_WARN_KW) do if l:find(kw) then drop = true; break end end
                end
                if not drop then keep[#keep+1] = a end
            end
            warnRecursionGuard = false
            if drop then return end
            return oldWarn(table.unpack(keep))
        end))
    end)
end

local function runPlusBypass()
    if HAS_GETCONN and not settingsConfig.StealthMode then
        pcall(function()
            local roots = { ReplicatedStorage, Workspace }
            for _, root in ipairs(roots) do
                for _, obj in ipairs(root:GetDescendants()) do
                    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                        local n = obj.Name:lower()
                        for _, w in ipairs(_SUS) do
                            if n:find(w) then
                                pcall(function()
                                    for _, c in ipairs(getconnections(obj.OnClientEvent)) do
                                        pcall(function() c:Disconnect() end)
                                    end
                                end)
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("LocalScript") or d:IsA("Script") then
                    local n = d.Name:lower()
                    for _, w in ipairs(_SUS) do
                        if n:find(w) then pcall(function() d.Disabled = true end); break end
                    end
                end
            end
        end
    end)
end

local LOADING_FLAG = "CubicScript.loaded"

local function isAlreadyLoaded()
    if _G.__cubicForceLoad then return false end
    local ok, exists = pcall(function() return isfile(LOADING_FLAG) end)
    if ok and exists then return true end
    return _G.__cubicLoadingDone == true
end

local function markLoaded()
    _G.__cubicLoadingDone = true
    _G.__cubicForceLoad = false
    pcall(function() writefile(LOADING_FLAG, tostring(tick())) end)
end

local function resetLoadedFlag()
    _G.__cubicLoadingDone = nil
    pcall(function()
        if type(delfile) == "function" and type(isfile) == "function" and isfile(LOADING_FLAG) then
            delfile(LOADING_FLAG)
        end
    end)
end


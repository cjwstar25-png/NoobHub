    local function applySkin(skinName)
        local char = LocalPlayer.Character
        if not char then return end
        if skinName == "Rainbow" then
            task.spawn(function()
                local hue = 0
                while states.SkinChanger and currentSkin == "Rainbow" do
                    hue = (hue + 0.01) % 1

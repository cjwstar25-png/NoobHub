    end

    _G.__cubicLoadProfile = function(name)
        if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
        local raw
        pcall(function() if isfile(profilePath(name)) then raw = readfile(profilePath(name)) end end)

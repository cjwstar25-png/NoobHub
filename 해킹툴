do
    local SAVE_PATH = "CubicScriptState.json"
    local saveDirty = false
    saveState = function() saveDirty = true end

    local function serializeKeybinds()
        local out = {}
        for k, v in pairs(keybinds) do if v and v.Name then out[k] = v.Name end end
        return out
    end
    local function deserializeKeybinds(tbl)
        if type(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            local ok, kc = pcall(function() return Enum.KeyCode[v] end)
            if ok and kc then keybinds[k] = kc end
        end
    end

    task.spawn(function()
        while true do
            task.wait(3)
            if saveDirty then
                saveDirty = false
                local data = { States=states, Settings=settingsConfig, Skin=currentSkin, Keybinds=serializeKeybinds() }
                pcall(function() writefile(SAVE_PATH, HttpService:JSONEncode(data)) end)
            end
        end
    end)

    local function applyData(data)
        if type(data) ~= "table" then return false end
        if data.States then
            for k, v in pairs(data.States) do
                if states[k] ~= nil and type(v) == type(states[k]) then states[k] = v end
            end
        end
        if data.Settings then
            for k, v in pairs(data.Settings) do
                if settingsConfig[k] ~= nil and type(v) == type(settingsConfig[k]) then settingsConfig[k] = v end
            end
        end
        if data.Skin then currentSkin = data.Skin end
        if data.Keybinds then keybinds = {}; deserializeKeybinds(data.Keybinds) end
        return true
    end

    local function loadState()
        local raw
        pcall(function() if isfile(SAVE_PATH) then raw = readfile(SAVE_PATH) end end)
        if not raw then return end
        pcall(function()
            local data = HttpService:JSONDecode(raw)
            applyData(data)
        end)
    end

    local CONFIG_FOLDER = "CubicConfigs"
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" then
            if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        end
    end)

    local function safeFileName(name) return (name:gsub("[^%w_%-]", "_")) end
    local function profilePath(name) return CONFIG_FOLDER .. "/" .. safeFileName(name) .. ".json" end

    _G.__cubicListProfiles = function()
        local out = {}
        pcall(function()
            if type(listfiles) == "function" then
                for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
                    local n = f:match("([^/\\]+)%.json$")
                    if n then table.insert(out, n) end
                end
            end
        end)
        table.sort(out)
        return out
    end

    _G.__cubicSaveProfile = function(name)
        if not name or name == "" then return false, "empty" end
        if type(writefile) ~= "function" then return false, "no writefile" end
        local data = { States=states, Settings=settingsConfig, Skin=currentSkin, Keybinds=serializeKeybinds(), _meta={savedAt=os.time(),version=10} }
